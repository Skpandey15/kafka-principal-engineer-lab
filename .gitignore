# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
!**/testdata/**/*.pem

# Kafka / Docker runtime data (never commit broker state)
kafka-data/
zookeeper-data/
**/docker/**/data/
**/docker/**/volumes/

# Test / coverage output
coverage/
*.exec
.jacoco/

# Node (for any tooling scripts)
node_modules/

# Local override files
*.local.yml
*.local.yaml
*.local.properties

# Downloaded Kafka Connect plugin artifacts (WP-11) -- fetched by
# platform/kafka-connect/fetch-debezium-plugin.sh, a pinned download, not
# committed source. The fetch script itself IS committed.
platform/kafka-connect/plugins/*
!platform/kafka-connect/plugins/.gitkeep

# FileStream connector experiment scratch files (WP-11) -- generated by
# running the lab's manual experiments, not committed source.
platform/kafka-connect/connect-data/*
!platform/kafka-connect/connect-data/.gitkeep

# Downloaded Prometheus JMX exporter Java agent (WP-16) -- fetched by
# platform/kafka-cluster/jmx-exporter/fetch-jmx-exporter.sh, a pinned
# download, not committed source. The fetch script and its config ARE
# committed.
platform/kafka-cluster/jmx-exporter/jmx_prometheus_javaagent.jar

# Generated CA/broker TLS material (WP-18) -- produced by
# platform/kafka-security/certs/generate-certs.sh, a real, freshly
# generated self-signed CA and signed broker cert every time the
# script runs, not committed source. The generation script and the
# static client-config templates (admin-client.properties,
# reader-client.properties) ARE committed.
platform/kafka-security/certs/*.p12
platform/kafka-security/certs/*.crt
platform/kafka-security/certs/*.key
platform/kafka-security/certs/*.csr
platform/kafka-security/certs/*.srl
platform/kafka-security/certs/*.ext
platform/kafka-security/certs/store-password.txt
