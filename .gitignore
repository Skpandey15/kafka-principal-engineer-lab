# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Gradle
.gradle/
**/build/
!src/**/build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
.factorypath
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
!**/testdata/**/*.pem

# Kafka / Docker runtime data (never commit broker state)
kafka-data/
zookeeper-data/
**/docker/**/data/
**/docker/**/volumes/

# Test / coverage output
coverage/
*.exec
.jacoco/

# Node (for any tooling scripts)
node_modules/

# Local override files
*.local.yml
*.local.yaml
*.local.properties

# Downloaded Kafka Connect plugin artifacts (WP-11) -- fetched by
# platform/kafka-connect/fetch-debezium-plugin.sh, a pinned download, not
# committed source. The fetch script itself IS committed.
platform/kafka-connect/plugins/*
!platform/kafka-connect/plugins/.gitkeep

# FileStream connector experiment scratch files (WP-11) -- generated by
# running the lab's manual experiments, not committed source.
platform/kafka-connect/connect-data/*
!platform/kafka-connect/connect-data/.gitkeep
