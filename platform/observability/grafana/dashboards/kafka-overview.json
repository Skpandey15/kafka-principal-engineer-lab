{
  "title": "Kafka Overview (WP-16)",
  "uid": "wp16-kafka-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer group lag by partition",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} / {{topic}} / p{{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Broker bytes-in per second (by topic)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_bytesin_total{topic!=\"\"}[1m])",
          "legendFormat": "{{topic}} @ {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Under-replicated partitions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "kafka_server_replicamanager_underreplicatedpartitions",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Request handler idle percent (lower = busier broker)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "kafka_server_kafkarequesthandlerpool_requesthandleravgidle_percent",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Per-partition current offset (throughput / hot-partition skew)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "kafka_topic_partition_current_offset",
          "legendFormat": "{{topic}} / p{{partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}
